# Canvas instance, for example https://school.instructure.com
CANVAS_BASE_URL=

# The one course this server is allowed to submit to.
CANVAS_COURSE_ID=

# The token is read from macOS Keychain, not from this file.
CANVAS_KEYCHAIN_SERVICE=canvas-submission-server
CANVAS_KEYCHAIN_ACCOUNT=canvas-api-token

# Separate local credential required by callers of this server.
SERVER_API_KEY=

# Exact phrase required on every write request after you confirm the submission.
SUBMISSION_CONFIRMATION_PHRASE=I CONFIRM THIS CANVAS SUBMISSION

PORT=8787
